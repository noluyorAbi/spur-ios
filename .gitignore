# Generated by XcodeGen
*.xcodeproj/
# Build output
build/
DerivedData/
*.xcresult
# Local signing settings (team, bundle prefix)
Config/Local.xcconfig
Config/Local.font
Config/Local.parent
# Proprietary font, copied in by scripts/install-font.sh
Spur/Resources/Fonts/*.ttf
Spur/Resources/Fonts/*.otf
# Offline road pack (OpenStreetMap, ODbL), built by scripts/build-osm-pack.sh
Spur/Resources/OSM/*.spurpack
# macOS
.DS_Store
# Scratch output of verification runs
.orchestra/tmp/
# Generated by XcodeGen from project.yml
Spur/Info.plist
SpurWidgets/Info.plist
.launch/
node_modules/
.env
.env.*
CLAUDE.local.md
DECISIONS.md
.orchestra/
